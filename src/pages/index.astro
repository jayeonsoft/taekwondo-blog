---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<section class="hero">
			<svg class="hero-arcs" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
				<circle cx="260" cy="1000" r="760" fill="none" stroke="rgba(255, 31, 75, 0.28)" stroke-width="1.5" />
				<circle cx="1360" cy="1040" r="820" fill="none" stroke="rgba(47, 107, 255, 0.26)" stroke-width="1.5" />
				<circle cx="800" cy="1080" r="600" fill="none" stroke="rgba(255, 31, 75, 0.14)" stroke-width="1" />
			</svg>
			<h1 class="hero-title">
				<span class="sans">
					<span class="serif accent-red">Dojang</span> to street,
				</span>
				<br />
				<span class="sans">
					we turn runs into <span class="serif accent-blue">devlogs</span>.
				</span>
			</h1>
			<p class="hero-sub">
				<a href="https://taekwondo.jayeonsoft.com">Seoul Nights</a> is a browser 3D taekwondo action
				game — train at a neon-lit dojang, earn belts, take on a street gang. No installs, guest
				play included. New chapters, moves and systems get written up here as they ship.
			</p>
			<a class="hero-cta" href="/blog">Read the devlog <span aria-hidden="true">&rsaquo;</span></a>
		</section>
		<main>
			<p>
				Want the background first? Read <a href="/about">more about the project</a> before diving
				into the <a href="/blog">devlog</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding: 5em 1em 4em;
		text-align: center;
	}
	.hero-arcs {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		pointer-events: none;
	}
	.hero-title,
	.hero-sub,
	.hero-cta {
		position: relative;
		z-index: 1;
	}
	.hero-title {
		font-family: var(--font-atkinson);
		font-style: normal;
		font-weight: 400;
		font-size: clamp(2.2rem, 6vw, 3.6rem);
		line-height: 1.2;
		margin: 0 auto 1.1em;
		max-width: 20em;
		color: rgb(var(--black));
	}
	.hero-title .serif {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 600;
	}
	.hero-title .accent-red {
		color: var(--accent);
		text-shadow: 0 0 28px var(--accent-soft);
	}
	.hero-title .accent-blue {
		color: var(--accent-blue);
		text-shadow: 0 0 28px var(--accent-blue-soft);
	}
	.hero-sub {
		max-width: 34em;
		margin: 0 auto 2.2em;
		color: rgb(var(--gray));
		font-size: 1.05em;
	}
	.hero-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.9em 1.7em;
		border-radius: 999px;
		background: var(--accent);
		color: var(--void);
		font-weight: 700;
		text-decoration: none;
		box-shadow: 0 0 30px var(--accent-soft);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.hero-cta:hover {
		color: var(--void);
		transform: translateY(-2px);
		box-shadow: 0 0 44px var(--accent-soft);
		text-shadow: none;
	}
	@media (max-width: 720px) {
		.hero {
			padding: 3.5em 1em 3em;
		}
	}
</style>
