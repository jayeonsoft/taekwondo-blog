---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Jayeonsoft. All rights reserved.
	<div class="social-links">
		<a href="https://taekwondo.jayeonsoft.com" target="_blank">Play Seoul Nights</a>
		<a href="https://x.com/SeoulNightTKD" target="_blank">X</a>
		<a href="https://github.com/jayeonsoft/taekwondo-blog" target="_blank">Blog source</a>
	</div>
</footer>
<style>
	footer {
		padding: 3em 1em 6em 1em;
		border-top: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.9em;
		letter-spacing: 0.02em;
	}
	.social-links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1.5em;
		margin-top: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: var(--accent);
	}
	.social-links a:hover {
		color: var(--accent-hi);
		text-shadow: 0 0 12px var(--accent-soft);
	}
</style>
