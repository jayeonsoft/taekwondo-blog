---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://taekwondo.jayeonsoft.com" target="_blank">Play the game</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1em;
		background: rgba(5, 6, 15, 0.78);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom: 1px solid rgba(47, 107, 255, 0.22);
	}
	h2 {
		margin: 0;
		font-size: 1.3em;
	}
	h2 a {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 700;
		color: rgb(var(--black));
		text-decoration: none;
		text-shadow: 0 0 18px var(--accent-soft);
		letter-spacing: 0.01em;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--gray-dark));
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 0.95em;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	nav a:hover {
		color: rgb(var(--black));
		text-shadow: none;
	}
	nav a.active {
		color: rgb(var(--black));
		border-bottom-color: var(--accent);
	}
	.social-links a {
		display: inline-flex;
		align-items: center;
		font-weight: 600;
		text-transform: none;
		letter-spacing: normal;
		color: var(--accent);
		padding: 0.5em 1.1em;
		border-radius: 999px;
		border: 1px solid rgba(255, 31, 75, 0.4);
		background: rgba(255, 31, 75, 0.1);
		transition: color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
	}
	.social-links a:hover {
		color: var(--void);
		background: var(--accent);
		box-shadow: 0 0 24px var(--accent-soft);
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
